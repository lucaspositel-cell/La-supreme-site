-- LA SUPREME: cadastro de combos para o painel com acesso individual.
-- Execute depois do SQL de acesso interno (staff_profiles).
begin;
create table if not exists public.pdv_combos (
 id bigint generated by default as identity primary key,
 name text not null check (length(trim(name)) between 1 and 120),
 price numeric(12,2) not null check (price > 0 and price <= 999999),
 active boolean not null default true,
 components jsonb not null check (jsonb_typeof(components)='array' and jsonb_array_length(components)>0),
 created_at timestamptz not null default now(),
 updated_at timestamptz not null default now()
);
alter table public.pdv_combos enable row level security;
revoke all on public.pdv_combos from anon;
grant select, insert, update on public.pdv_combos to authenticated;
grant usage, select on sequence public.pdv_combos_id_seq to authenticated;
drop policy if exists combo_staff_read on public.pdv_combos;
create policy combo_staff_read on public.pdv_combos for select to authenticated
using (exists (select 1 from public.staff_profiles p where p.user_id=auth.uid() and p.active and p.role in ('administrador','gerente','operador')));
drop policy if exists combo_manager_insert on public.pdv_combos;
create policy combo_manager_insert on public.pdv_combos for insert to authenticated
with check (exists (select 1 from public.staff_profiles p where p.user_id=auth.uid() and p.active and p.role in ('administrador','gerente')));
drop policy if exists combo_manager_update on public.pdv_combos;
create policy combo_manager_update on public.pdv_combos for update to authenticated
using (exists (select 1 from public.staff_profiles p where p.user_id=auth.uid() and p.active and p.role in ('administrador','gerente')))
with check (exists (select 1 from public.staff_profiles p where p.user_id=auth.uid() and p.active and p.role in ('administrador','gerente')));
-- Validação da composição também no banco, inclusive chamadas diretas.
create or replace function public.validate_pdv_combo_components()
returns trigger language plpgsql set search_path=public as $$
declare item jsonb;
begin
 if jsonb_typeof(new.components)<>'array' or jsonb_array_length(new.components) not between 1 and 100 then
  raise exception 'Combo deve conter de 1 a 100 componentes';
 end if;
 for item in select value from jsonb_array_elements(new.components) loop
  if jsonb_typeof(item)<>'object' or coalesce(length(trim(item->>'name')),0)=0
   or jsonb_typeof(item->'qty') is distinct from 'number'
   or (item->>'qty')::numeric not between 1 and 99
   or (item->>'qty')::numeric<>trunc((item->>'qty')::numeric)
   or jsonb_typeof(item->'unit') is distinct from 'number'
   or (item->>'unit')::numeric<0 then
   raise exception 'Componente inválido: confira nome, quantidade e preço de referência';
  end if;
 end loop;
 new.updated_at=now();
 return new;
end $$;
drop trigger if exists validate_pdv_combo on public.pdv_combos;
create trigger validate_pdv_combo before insert or update on public.pdv_combos
for each row execute function public.validate_pdv_combo_components();
commit;
